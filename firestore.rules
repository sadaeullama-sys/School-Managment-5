rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'system_admin';
    }
    function ownsSchool(schoolId) {
      return signedIn()
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.ownerUid == request.auth.uid;
    }
    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update, delete: if isSystemAdmin();
    }
    match /admins/{adminUid} {
      allow get: if signedIn() && request.auth.uid == adminUid;
      allow list: if false;
      allow write: if false;
    }
    match /schools/{schoolId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schoolId == schoolId
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.ownerUid == request.auth.uid || isSystemAdmin());
      allow update: if isSystemAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewedAt','subscriptionStatus','subscriptionPlan',
          'subscriptionStartedAt','subscriptionExpiresAt',
            'subscriptionPaymentMethod',
            'subscriptionTransactionId',
            'subscriptionApprovedBy','subscriptionApprovedAt',
          'subscriptionApprovedBy','subscriptionPaymentMethod','subscriptionTransactionId'
        ]);
      allow delete: if false;

      match /paymentRequests/{requestId} {
        allow create: if ownsSchool(schoolId)
          && request.resource.data.schoolId == schoolId
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.plan in ['Weekly','Monthly','Yearly','Lifetime']
          && request.resource.data.method in ['JazzCash','Easypaisa','Bank Transfer']
          && request.resource.data.amount is int
          && request.resource.data.transactionId is string;
        allow read: if isSystemAdmin() || ownsSchool(schoolId);
        allow update, delete: if isSystemAdmin();
      }
    }
    match /schools/{schoolId}/{document=**} {
      allow read, write: if ownsSchool(schoolId)
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.status == 'approved';
    }
  }
}
